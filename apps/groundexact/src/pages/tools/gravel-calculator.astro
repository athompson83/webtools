---
import ToolPageLayout from '../../layouts/ToolPageLayout.astro';
---
<ToolPageLayout
  title="Gravel & Stone Calculator"
  description="Estimate gravel or stone cubic yards, waste-adjusted bulk order quantity, and weight using the material density supplied by your vendor."
  pathname="/tools/gravel-calculator"
  intro="Calculate bulk volume first, then estimate weight using the density for the specific aggregate you plan to buy."
  reviewedDate="August 18, 2026"
  formulaSummary="GroundExact calculates geometric volume independently from material weight. Weight is estimated only after you provide a pounds-per-cubic-foot density for the specific stone or aggregate."
  relatedTools={[]}
>
  <form slot="calculator" data-gravel-form novalidate>
    <h2>Project and material</h2>
    <div class="field-grid">
      <label>Length (ft)<input name="length" type="number" inputmode="decimal" min="0" step="0.1" value="20" required /></label>
      <label>Width (ft)<input name="width" type="number" inputmode="decimal" min="0" step="0.1" value="10" required /></label>
      <label>Depth (in)<input name="depth" type="number" inputmode="decimal" min="0" step="0.25" value="3" required /></label>
      <label>Extra / waste (%)<input name="waste" type="number" inputmode="decimal" min="0" max="100" step="1" value="5" required /></label>
      <label>Material density (lb/ft³)<input name="density" type="number" inputmode="decimal" min="0.01" step="0.1" placeholder="Enter supplier value" required /></label>
      <label>Supplier order increment (yd³)<input name="increment" type="number" inputmode="decimal" min="0.01" step="0.05" value="0.25" required /></label>
    </div>
    <p class="helper">Aggregate density varies by stone type, gradation, moisture, and supplier. Enter a density from your supplier or another source appropriate to the material. GroundExact intentionally does not prefill one universal value.</p>
    <div class="calc-actions">
      <button class="btn" type="submit">Calculate gravel</button>
      <button class="btn secondary" type="button" data-reset>Reset</button>
    </div>
    <p class="notice" data-error>Enter the material density to calculate the weight estimate.</p>
  </form>

  <div slot="results">
    <p class="result-kicker">Recommended bulk order</p>
    <p class="result-primary"><span data-order>—</span> yd³</p>
    <p>Volume is based on project geometry; the ton estimate depends on the density you enter.</p>
    <ul class="result-list">
      <li><span>Project area</span><strong><span data-area>—</span> sq ft</strong></li>
      <li><span>Calculated need</span><strong><span data-base>—</span> yd³</strong></li>
      <li><span>With extra allowance</span><strong><span data-adjusted>—</span> yd³</strong></li>
      <li><span>Estimated weight</span><strong><span data-tons>—</span> tons</strong></li>
    </ul>
  </div>

  <div slot="methodology">
    <p><code>cubic yards = length × width × (depth inches ÷ 12) ÷ 27</code></p>
    <p><code>estimated tons = adjusted cubic feet × density (lb/ft³) ÷ 2,000</code></p>
    <p>The tonnage result is an estimate, not a scale ticket. Actual delivered weight and usable volume can vary with material composition, moisture, compaction, supplier measurement, and field conditions.</p>
  </div>

  <section slot="example" class="example-block">
    <p class="eyebrow">Worked example</p>
    <h2>20 ft × 10 ft × 3 in</h2>
    <p>The geometric requirement is about 1.85 cubic yards. With 5% extra, it is about 1.94 cubic yards, which rounds to 2.00 cubic yards when a supplier sells in 0.25-yard increments. If—and only if—the selected material density is 100 lb/ft³, the adjusted quantity corresponds to approximately 2.63 tons.</p>
  </section>
</ToolPageLayout>

<script>
  import { calculateGravel } from '../../tools/gravel/calculate';

  const form = document.querySelector('[data-gravel-form]');
  if (form instanceof HTMLFormElement) {
    const outputs = {
      area: document.querySelector('[data-area]'),
      base: document.querySelector('[data-base]'),
      adjusted: document.querySelector('[data-adjusted]'),
      order: document.querySelector('[data-order]'),
      tons: document.querySelector('[data-tons]'),
    };
    const errorOut = form.querySelector('[data-error]');

    const render = () => {
      const data = new FormData(form);
      const densityRaw = String(data.get('density') ?? '').trim();
      if (!densityRaw) {
        if (errorOut instanceof HTMLElement) { errorOut.hidden = false; errorOut.textContent = 'Enter the material density to calculate the weight estimate.'; }
        return;
      }
      try {
        const result = calculateGravel({
          lengthFt: Number(data.get('length')),
          widthFt: Number(data.get('width')),
          depthInches: Number(data.get('depth')),
          wastePercent: Number(data.get('waste')),
          densityLbPerCuFt: Number(densityRaw),
          bulkIncrementCuYd: Number(data.get('increment')),
        });
        if (outputs.area) outputs.area.textContent = result.areaSqFt.toLocaleString('en-US', { maximumFractionDigits: 2 });
        if (outputs.base) outputs.base.textContent = result.baseCuYd.toFixed(2);
        if (outputs.adjusted) outputs.adjusted.textContent = result.adjustedCuYd.toFixed(2);
        if (outputs.order) outputs.order.textContent = result.recommendedOrderCuYd.toFixed(2);
        if (outputs.tons) outputs.tons.textContent = result.estimatedTons.toFixed(2);
        if (errorOut instanceof HTMLElement) { errorOut.hidden = true; errorOut.textContent = ''; }

        const url = new URL(window.location.href);
        for (const name of ['length', 'width', 'depth', 'waste', 'density', 'increment']) url.searchParams.set(name, String(data.get(name)));
        history.replaceState(null, '', `${url.pathname}?${url.searchParams.toString()}`);
      } catch (error) {
        if (errorOut instanceof HTMLElement) { errorOut.hidden = false; errorOut.textContent = error instanceof Error ? error.message : 'Check your inputs and try again.'; }
      }
    };

    form.addEventListener('submit', (event) => { event.preventDefault(); render(); });
    form.querySelector('[data-reset]')?.addEventListener('click', () => {
      form.reset();
      history.replaceState(null, '', window.location.pathname);
      for (const output of Object.values(outputs)) if (output) output.textContent = '—';
      render();
    });

    const params = new URLSearchParams(window.location.search);
    for (const name of ['length', 'width', 'depth', 'waste', 'density', 'increment']) {
      const input = form.elements.namedItem(name);
      const value = params.get(name);
      if (input instanceof HTMLInputElement && value !== null) input.value = value;
    }
    render();
  }
</script>

<style>
  [data-gravel-form] h2 { margin-top: 0; }
  .field-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  label { display: grid; gap: .45rem; font-weight: 700; }
  input { width: 100%; padding: .85rem .9rem; border: 1px solid var(--border); background: white; color: var(--text); font: inherit; }
  .helper { color: var(--muted-text); font-size: .9rem; line-height: 1.6; }
  .calc-actions { display: flex; gap: .75rem; margin-top: 1.25rem; flex-wrap: wrap; }
  .notice { margin-top: 1rem; color: var(--muted-text); }
  .result-kicker { margin-top: 0; color: var(--muted-text); font-size: .8rem; font-weight: 800; text-transform: uppercase; letter-spacing: .1em; }
  .result-primary { margin: .35rem 0 .8rem; font-size: clamp(3rem, 7vw, 5rem); line-height: .95; font-weight: 850; letter-spacing: -.05em; }
  .result-list { list-style: none; padding: 0; margin: 1.5rem 0 0; border-top: 1px solid var(--border); }
  .result-list li { display: flex; justify-content: space-between; gap: 1rem; padding: .8rem 0; border-bottom: 1px solid var(--border); }
  .example-block { max-width: 760px; padding-block: 4rem; }
  .example-block h2 { margin: .3rem 0 1rem; font-size: clamp(2rem, 4vw, 3.2rem); }
  .example-block p { line-height: 1.7; }
  @media (max-width: 650px) { .field-grid { grid-template-columns: 1fr; } }
</style>
