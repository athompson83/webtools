---
import ToolPageLayout from '../../layouts/ToolPageLayout.astro';
---
<ToolPageLayout
  title="Topsoil Calculator"
  description="Estimate topsoil cubic yards from project length, width, depth, waste allowance, and supplier order increment."
  pathname="/tools/topsoil-calculator"
  intro="Turn bed, lawn, or fill dimensions into a waste-adjusted cubic-yard estimate and practical supplier-rounded bulk order."
  reviewedDate="August 18, 2026"
  formulaSummary="GroundExact converts your rectangular area and depth into cubic yards, applies only the extra percentage you choose, and then rounds upward to the supplier order increment you enter."
  relatedTools={[]}
>
  <form slot="calculator" data-topsoil-form novalidate>
    <h2>Project measurements</h2>
    <div class="field-grid">
      <label>Length (ft)<input name="length" type="number" inputmode="decimal" min="0" step="0.1" value="30" required /></label>
      <label>Width (ft)<input name="width" type="number" inputmode="decimal" min="0" step="0.1" value="12" required /></label>
      <label>Depth (in)<input name="depth" type="number" inputmode="decimal" min="0" step="0.25" value="2" required /></label>
      <label>Extra / waste (%)<input name="waste" type="number" inputmode="decimal" min="0" max="100" step="1" value="10" required /></label>
      <label>Supplier order increment (yd³)<input name="increment" type="number" inputmode="decimal" min="0.01" step="0.05" value="0.25" required /></label>
    </div>
    <p class="helper">Use the order increment your supplier actually sells. GroundExact does not assume every supplier sells by quarter-yard increments.</p>
    <div class="calc-actions">
      <button class="btn" type="submit">Calculate topsoil</button>
      <button class="btn secondary" type="button" data-reset>Reset</button>
    </div>
    <p class="notice" data-error hidden></p>
  </form>

  <div slot="results">
    <p class="result-kicker">Recommended bulk order</p>
    <p class="result-primary"><span data-order>2.50</span> yd³</p>
    <p>Rounded upward only after applying your selected extra allowance.</p>
    <ul class="result-list">
      <li><span>Project area</span><strong><span data-area>360</span> sq ft</strong></li>
      <li><span>Calculated need</span><strong><span data-base>2.22</span> yd³</strong></li>
      <li><span>With extra allowance</span><strong><span data-adjusted>2.44</span> yd³</strong></li>
    </ul>
  </div>

  <div slot="methodology">
    <p><code>cubic yards = length × width × (depth inches ÷ 12) ÷ 27</code></p>
    <p><code>adjusted = cubic yards × (1 + extra percentage)</code></p>
    <p>The final order recommendation rounds upward to the supplier increment you enter. Settlement, compaction, moisture, existing grade, and actual delivered volume can change field requirements.</p>
  </div>

  <section slot="example" class="example-block">
    <p class="eyebrow">Worked example</p>
    <h2>30 ft × 12 ft × 2 in</h2>
    <p>The project is 360 square feet. At 2 inches deep it requires about 2.22 cubic yards before extra allowance. Adding 10% produces about 2.44 cubic yards; with a 0.25-yard supplier increment the practical order rounds up to 2.50 cubic yards.</p>
  </section>
</ToolPageLayout>

<script>
  import { calculateTopsoil } from '../../tools/topsoil/calculate';

  const form = document.querySelector('[data-topsoil-form]');
  if (form instanceof HTMLFormElement) {
    const outputs = {
      area: document.querySelector('[data-area]'),
      base: document.querySelector('[data-base]'),
      adjusted: document.querySelector('[data-adjusted]'),
      order: document.querySelector('[data-order]'),
    };
    const errorOut = form.querySelector('[data-error]');

    const render = () => {
      try {
        const data = new FormData(form);
        const result = calculateTopsoil({
          lengthFt: Number(data.get('length')),
          widthFt: Number(data.get('width')),
          depthInches: Number(data.get('depth')),
          wastePercent: Number(data.get('waste')),
          bulkIncrementCuYd: Number(data.get('increment')),
        });
        if (outputs.area) outputs.area.textContent = result.areaSqFt.toLocaleString('en-US', { maximumFractionDigits: 2 });
        if (outputs.base) outputs.base.textContent = result.baseCuYd.toFixed(2);
        if (outputs.adjusted) outputs.adjusted.textContent = result.adjustedCuYd.toFixed(2);
        if (outputs.order) outputs.order.textContent = result.recommendedOrderCuYd.toFixed(2);
        if (errorOut instanceof HTMLElement) { errorOut.hidden = true; errorOut.textContent = ''; }

        const url = new URL(window.location.href);
        for (const name of ['length', 'width', 'depth', 'waste', 'increment']) url.searchParams.set(name, String(data.get(name)));
        history.replaceState(null, '', `${url.pathname}?${url.searchParams.toString()}`);
      } catch (error) {
        if (errorOut instanceof HTMLElement) { errorOut.hidden = false; errorOut.textContent = error instanceof Error ? error.message : 'Check your measurements and try again.'; }
      }
    };

    form.addEventListener('submit', (event) => { event.preventDefault(); render(); });
    form.querySelector('[data-reset]')?.addEventListener('click', () => { form.reset(); history.replaceState(null, '', window.location.pathname); render(); });
    const params = new URLSearchParams(window.location.search);
    for (const name of ['length', 'width', 'depth', 'waste', 'increment']) {
      const input = form.elements.namedItem(name);
      const value = params.get(name);
      if (input instanceof HTMLInputElement && value !== null) input.value = value;
    }
    render();
  }
</script>

<style>
  [data-topsoil-form] h2 { margin-top: 0; }
  .field-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  label { display: grid; gap: .45rem; font-weight: 700; }
  input { width: 100%; padding: .85rem .9rem; border: 1px solid var(--border); background: white; color: var(--text); font: inherit; }
  .helper { color: var(--muted-text); font-size: .9rem; line-height: 1.6; }
  .calc-actions { display: flex; gap: .75rem; margin-top: 1.25rem; flex-wrap: wrap; }
  .notice { margin-top: 1rem; color: #8a2d22; }
  .result-kicker { margin-top: 0; color: var(--muted-text); font-size: .8rem; font-weight: 800; text-transform: uppercase; letter-spacing: .1em; }
  .result-primary { margin: .35rem 0 .8rem; font-size: clamp(3rem, 7vw, 5rem); line-height: .95; font-weight: 850; letter-spacing: -.05em; }
  .result-list { list-style: none; padding: 0; margin: 1.5rem 0 0; border-top: 1px solid var(--border); }
  .result-list li { display: flex; justify-content: space-between; gap: 1rem; padding: .8rem 0; border-bottom: 1px solid var(--border); }
  .example-block { max-width: 760px; padding-block: 4rem; }
  .example-block h2 { margin: .3rem 0 1rem; font-size: clamp(2rem, 4vw, 3.2rem); }
  .example-block p { line-height: 1.7; }
  @media (max-width: 650px) { .field-grid { grid-template-columns: 1fr; } }
</style>
