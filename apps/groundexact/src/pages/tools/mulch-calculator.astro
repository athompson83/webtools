---
import ToolPageLayout from '../../layouts/ToolPageLayout.astro';
---
<ToolPageLayout
  title="Mulch Calculator"
  description="Calculate mulch cubic yards, an adjustable extra allowance, practical bulk order quantity, and bag equivalents."
  pathname="/tools/mulch-calculator"
  intro="Turn measured bed area and mulch depth into cubic yards, a practical rounded bulk order, and bag equivalents without hiding the underlying quantity."
  reviewedDate="August 18, 2026"
  formulaSummary="GroundExact converts the selected depth from inches to feet, calculates cubic yards from area and depth, applies your selected extra allowance, then rounds the bulk order upward to a quarter-yard increment and calculates whole-bag equivalents."
  relatedTools={[]}
>
  <form slot="calculator" data-mulch-form novalidate>
    <h2>Bed and product details</h2>
    <div class="field-grid">
      <label>Project area (sq ft)<input name="area" type="number" inputmode="decimal" min="0" step="0.1" value="327" required /></label>
      <label>Mulch depth (in)<input name="depth" type="number" inputmode="decimal" min="0" step="0.25" value="3" required /></label>
      <label>Extra / waste (%)<input name="waste" type="number" inputmode="decimal" min="0" max="100" step="1" value="5" required /></label>
      <label>Bag size (cu ft)
        <select name="bag">
          <option value="1.5">1.5 cu ft</option>
          <option value="2" selected>2 cu ft</option>
          <option value="3">3 cu ft</option>
        </select>
      </label>
    </div>
    <p class="helper">Use measured bed area when possible. Irregular beds can be divided into simpler shapes and added together. Compaction, settling, delivered volume, and supplier order increments can affect real-world needs.</p>
    <div class="calc-actions">
      <button class="btn" type="submit">Calculate mulch</button>
      <button class="btn secondary" type="button" data-reset>Reset</button>
    </div>
    <p class="notice" data-error hidden></p>
  </form>

  <div slot="results">
    <p class="result-kicker">Recommended bulk order</p>
    <p class="result-primary"><span data-order>3.25</span> yd³</p>
    <p>Rounded upward to the nearest quarter cubic yard after the selected extra allowance.</p>
    <ul class="result-list">
      <li><span>Calculated need</span><strong><span data-base>3.03</span> yd³</strong></li>
      <li><span>With extra allowance</span><strong><span data-adjusted>3.18</span> yd³</strong></li>
      <li><span>Bag equivalent</span><strong><span data-bags>43</span> bags</strong></li>
    </ul>
  </div>

  <div slot="methodology">
    <p><code>cubic yards = area (sq ft) × (depth inches ÷ 12) ÷ 27</code></p>
    <p><code>adjusted cubic yards = cubic yards × (1 + extra percentage)</code></p>
    <p>The bulk recommendation rounds upward to the nearest 0.25 cubic yard in the current MVP. Bag equivalents use the bag volume you select and round upward to a whole bag.</p>
    <p>The appropriate mulch depth depends on the project, material, existing bed, and local horticultural guidance. GroundExact does not force one universal recommended depth.</p>
  </div>

  <section slot="example" class="example-block">
    <p class="eyebrow">Worked example</p>
    <h2>327 sq ft × 3 in</h2>
    <p>A 327-square-foot bed at 3 inches deep requires about 3.03 cubic yards before extra allowance. With 5% extra, the quantity becomes about 3.18 cubic yards, so the quarter-yard order recommendation is 3.25 cubic yards. At 2 cubic feet per bag, the adjusted volume is 43 whole bags.</p>
  </section>
</ToolPageLayout>

<script>
  import { formState, hydrateNamedFields, replaceToolState } from '@webtools/tool-runtime';
  import { calculateMulch } from '../../tools/mulch/calculate';

  const fields = ['area', 'depth', 'waste', 'bag'] as const;
  const form = document.querySelector('[data-mulch-form]');
  if (form instanceof HTMLFormElement) {
    const errorOut = form.querySelector('[data-error]');
    const outputs = {
      order: document.querySelector('[data-order]'),
      base: document.querySelector('[data-base]'),
      adjusted: document.querySelector('[data-adjusted]'),
      bags: document.querySelector('[data-bags]'),
    };

    const render = () => {
      try {
        const data = new FormData(form);
        const result = calculateMulch({
          areaSqFt: Number(data.get('area')),
          depthInches: Number(data.get('depth')),
          wastePercent: Number(data.get('waste')),
          bagSizeCuFt: Number(data.get('bag')),
          orderIncrementCuYd: 0.25,
        });

        if (outputs.order) outputs.order.textContent = result.recommendedOrderCuYd.toFixed(2);
        if (outputs.base) outputs.base.textContent = result.baseCuYd.toFixed(2);
        if (outputs.adjusted) outputs.adjusted.textContent = result.adjustedCuYd.toFixed(2);
        if (outputs.bags) outputs.bags.textContent = result.bagCount.toLocaleString('en-US');
        if (errorOut instanceof HTMLElement) { errorOut.hidden = true; errorOut.textContent = ''; }
        replaceToolState(window.location.pathname, formState(form, fields));
      } catch (error) {
        if (errorOut instanceof HTMLElement) { errorOut.hidden = false; errorOut.textContent = error instanceof Error ? error.message : 'Check your values and try again.'; }
      }
    };

    form.addEventListener('submit', (event) => { event.preventDefault(); render(); });
    form.querySelector('[data-reset]')?.addEventListener('click', () => {
      form.reset();
      history.replaceState(null, '', window.location.pathname);
      render();
    });

    hydrateNamedFields(form, new URLSearchParams(window.location.search), fields);
    render();
  }
</script>

<style>
  [data-mulch-form] h2 { margin-top: 0; }
  .field-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  label { display: grid; gap: .45rem; font-weight: 700; }
  input, select { width: 100%; padding: .85rem .9rem; border: 1px solid var(--border); background: white; color: var(--text); font: inherit; }
  .helper { color: var(--muted-text); font-size: .9rem; line-height: 1.6; }
  .calc-actions { display: flex; gap: .75rem; margin-top: 1.25rem; flex-wrap: wrap; }
  .notice { margin-top: 1rem; color: #8a2d22; }
  .result-kicker { margin-top: 0; color: var(--muted-text); font-size: .8rem; font-weight: 800; text-transform: uppercase; letter-spacing: .1em; }
  .result-primary { margin: .35rem 0 .8rem; font-size: clamp(3rem, 7vw, 5rem); line-height: .95; font-weight: 850; letter-spacing: -.05em; }
  .result-list { list-style: none; padding: 0; margin: 1.5rem 0 0; border-top: 1px solid var(--border); }
  .result-list li { display: flex; justify-content: space-between; gap: 1rem; padding: .8rem 0; border-bottom: 1px solid var(--border); }
  .example-block { max-width: 760px; padding-block: 4rem; }
  .example-block h2 { margin: .3rem 0 1rem; font-size: clamp(2rem, 4vw, 3.2rem); }
  .example-block p { line-height: 1.7; }
  @media (max-width: 650px) { .field-grid { grid-template-columns: 1fr; } }
</style>
