{
  "name": "webtools",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10.14 <11"
  },
  "scripts": {
    "dev:groundexact": "pnpm --filter @webtools/groundexact dev",
    "create:site": "node scripts/create-site.mjs",
    "build": "pnpm -r build",
    "test": "pnpm -r test && node --test scripts/lib/*.test.mjs",
    "lint": "pnpm -r lint && eslint scripts --max-warnings=0",
    "typecheck": "pnpm -r typecheck",
    "validate:portfolio": "node scripts/validate-portfolio.mjs",
    "validate:dist": "node scripts/validate-dist.mjs",
    "format": "prettier --write .",
    "check": "pnpm validate:portfolio && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm validate:dist"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "eslint": "^9.33.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1"
  }
}
